# ==========================================
# Configuration Backend NMR - Docker
# ==========================================

# Réseau et CORS
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TZ=Europe/Paris

# Limites
BODY_LIMIT_MB=500
MAX_UPLOAD_MB=500
TASK_TTL_HOURS=48
AUTO_CLEANUP_INTERVAL_HOURS=48

# Processus
PROCESS_TIMEOUT_HOURS=8
MEMORY_LIMIT_MB=6144
ENABLE_PROCESS_MONITORING=true
ENABLE_CHECKPOINTS=true
KILL_ON_CLIENT_CLOSE=false

# Exécutables
R_PATH=/usr/bin/Rscript
PRED_PYTHON=/opt/conda/envs/nmr/bin/python

# Modèles ML (inclus dans l'image backend)
MODEL_1H_PATH=/app/backend/models/1H_sparsified_proposed_proposed_set2set_1.pt
MODEL_13C_PATH=/app/backend/models/13C_sparsified_proposed_proposed_set2set_1.pt
NMR_DATA_DIR=/app/backend/ml_dependencies/data

# Python
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
PYTHONUNBUFFERED=1
DGLBACKEND=pytorch

# Propriétés
PROPERTY_KEY=1

# Debug (false en production)
DEBUG_MEMORY=false
DEBUG_PROCESSES=false
DEBUG_SSE=false

# Performance
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4

# Ports Docker
FRONTEND_PORT=3000
BACKEND_PORT=4000
